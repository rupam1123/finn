FINN_DB=data/finn.sqlite3
NEXT_PUBLIC_API_BASE=
FINN_ALLOWED_ORIGINS=http://localhost:3000
FINN_PUBLIC_REVIEW=0

# Optional owner model execution; saved-data review needs no model key.
# Keep real keys in your private .env. Never use NEXT_PUBLIC_ for a key.
GEMINI_API_KEY=
# Set explicit model IDs available in your own provider project before --use-model.
# FINN_FLASH_MODEL=your-accessible-model-id
# FINN_REASONING_MODEL=your-accessible-model-id

# Per-process pacing only. This does not increase provider/project quota.
FINN_MODEL_RPM=12
