{
  "name": "finn-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --import tsx tests/integration.mjs",
    "test:pull-races": "node --import tsx tests/pull-races.mjs",
    "test:day4": "node --import tsx tests/day4-ui.mjs && node tests/day4-service-worker.mjs",
    "test:visuals": "node --import tsx tests/market-visuals.mjs",
    "test:safeguards": "node --import tsx tests/review-safeguards.mjs",
    "test:workspace": "node --import tsx tests/day4-ui.mjs && node --import tsx tests/pull-races.mjs && node --import tsx tests/review-safeguards.mjs && node --import tsx tests/market-visuals.mjs && node --import tsx tests/workspace-ui.mjs && node tests/day4-service-worker.mjs && node --import tsx tests/theme.mjs && node --import tsx tests/fluid.mjs && node --import tsx tests/polish.mjs",
    "test:theme": "node --import tsx tests/theme.mjs",
    "test:fluid": "node --import tsx tests/fluid.mjs",
    "test:polish": "node --import tsx tests/polish.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
