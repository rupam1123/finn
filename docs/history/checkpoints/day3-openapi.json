    "/api/push/digest": {
      "get": {
        "summary": "Push Digest",
        "operationId": "push_digest_api_push_digest_get",
        "parameters": [
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "1d",
                "3d",
                "7d",
                "30d",
                "latest"
              ],
              "type": "string",
              "default": "1d",
              "title": "Window"
            }
          },
          {
            "name": "price_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100,
              "exclusiveMinimum": 0,
              "default": 3.0,
              "title": "Price Threshold"
            }
          },
          {
            "name": "vol_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100,
              "exclusiveMinimum": 0,
              "default": 2.0,
              "title": "Vol Threshold"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          },
          {
            "name": "watch_categories",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Watch Categories"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
